{
  "name": "octo-web",
  "private": true,
  "version": "1.5.0",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=!./apps/extension",
    "dev:all": "turbo run dev --parallel",
    "dev-ele": "turbo run dev-ele --parallel",
    "build": "turbo run build",
    "build-ele": "turbo run build && turbo run build-ele",
    "build-ele:mac": "turbo run build && turbo run build-ele:mac",
    "build-ele:win": "turbo run build && turbo run build-ele:win",
    "build-ele:linux": "turbo run build && turbo run build-ele:linux",
    "build-ele:linux-arm64": "turbo run build && turbo run build-ele:linux-arm64",
    "bootstrap": "yarn install",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test --concurrency=1 -- --testTimeout=30000 --coverage --coverage.all --coverage.reportOnFailure --coverage.include='{src,src-election}/**/*.{ts,tsx}' --coverage.exclude='src/index.tsx' --coverage.exclude='**/*.stories.{ts,tsx}' --coverage.exclude='**/e2e-kit/**' --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "lint:css": "stylelint '**/*.css' --config stylelint.config.mjs --allow-empty-input && pnpm lint:wkmodal",
    "lint:css:ci": "stylelint --config stylelint.ci.config.mjs --allow-empty-input && pnpm lint:wkmodal",
    "lint:wkmodal": "node scripts/check-wkmodal-semi-overrides.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs scan",
    "i18n:check": "node scripts/i18n-scan.mjs check",
    "i18n:baseline": "node scripts/i18n-scan.mjs baseline",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "gen:component": "node scripts/gen-component.mjs",
    "new:worktree": "node scripts/run-bash-script.mjs scripts/new-worktree.sh",
    "cleanup:worktree": "node scripts/run-bash-script.mjs scripts/cleanup-worktree.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-vitest": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^7.32.0",
    "eslint-config-custom": "*",
    "jsdom": "^29.0.1",
    "prettier": "^2.5.1",
    "rimraf": "^5.0.5",
    "stylelint": "^17.6.0",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.19"
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "katex": "^0.18.4",
    "lucide-react": "^0.577.0",
    "pinyin-pro": "^3.29.3",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zxcvbn": "^4.4.2"
  },
  "packageManager": "pnpm@10.32.0"
}
