new file mode 100644
index 0000000000000000000000000000000000000000..a15f7a9b811b775afceeeab5c058a2473694ef11
--- /dev/null
+++ b/dist/dev/octo-native-shapes.js
@@ -0,0 +1,92 @@
+export const OCTO_NATIVE_SHAPE_KINDS = [
+  "triangle",
+  "inverted-triangle",
+  "parallelogram"
+];
+
+export const OCTO_SHAPE_TOOLBAR_SLOTS = [
+  "rectangle",
+  "rounded-rectangle",
+  "diamond",
+  "ellipse",
+  ...OCTO_NATIVE_SHAPE_KINDS
+];
+
+export const OCTO_LINE_TOOLBAR_SLOTS = [
+  "curved-arrow",
+  "elbow-arrow",
+  "straight-arrow",
+  "straight-line"
+];
+
+export const OCTO_RICH_TEXT_RESIZE_MARKER = "OCTO_RICH_TEXT_RESIZE_V1";
+
+export const getOctoToolbarContract = (viewModeEnabled = false) => ({
+  canCreate: !viewModeEnabled,
+  shapePrimary: viewModeEnabled ? null : "rectangle",
+  linePrimary: viewModeEnabled ? null : "arrow",
+  shapeFlyout: viewModeEnabled ? [] : OCTO_SHAPE_TOOLBAR_SLOTS,
+  lineFlyout: viewModeEnabled ? [] : OCTO_LINE_TOOLBAR_SLOTS
+});
+
+export const isOctoNativeShapeKind = (value) => OCTO_NATIVE_SHAPE_KINDS.includes(value);
+
+export const getOctoNativeShapeElementProps = (kind) => {
+  if (!isOctoNativeShapeKind(kind)) return null;
+  return {
+    type: "rectangle",
+    roundness: null,
+    customData: { nativeShapeKind: kind }
+  };
+};
+
+export const getOctoNativeShapePoints = (kind, width, height, x = 0, y = 0) => {
+  if (kind === "triangle") {
+    return [[x + width / 2, y], [x + width, y + height], [x, y + height]];
+  }
+  if (kind === "inverted-triangle") {
+    return [[x, y], [x + width, y], [x + width / 2, y + height]];
+  }
+  if (kind === "parallelogram") {
+    return [[x + width * 0.2, y], [x + width, y], [x + width * 0.8, y + height], [x, y + height]];
+  }
+  return null;
+};
+
+export const getOctoNativeShapeBounds = (kind, width, height, x = 0, y = 0) => {
+  const points = getOctoNativeShapePoints(kind, width, height, x, y);
+  if (!points) return null;
+  const xs = points.map(([pointX]) => pointX);
+  const ys = points.map(([, pointY]) => pointY);
+  return [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)];
+};
+
+export const isPointInOctoNativeShape = (kind, width, height, pointX, pointY, x = 0, y = 0) => {
+  const points = getOctoNativeShapePoints(kind, width, height, x, y);
+  if (!points) return false;
+  let inside = false;
+  for (let index = 0, previous = points.length - 1; index < points.length; previous = index++) {
+    const [currentX, currentY] = points[index];
+    const [previousX, previousY] = points[previous];
+    const intersects = currentY > pointY !== previousY > pointY && pointX < (previousX - currentX) * (pointY - currentY) / (previousY - currentY) + currentX;
+    if (intersects) inside = !inside;
+  }
+  return inside;
+};
+
+export const scaleOctoTextTypography = (element, scale) => {
+  const stable = (value) => Math.max(Number.EPSILON, Math.round(value * 1e6) / 1e6);
+  const fontSize = stable(element.fontSize * scale);
+  const stableScale = fontSize / element.fontSize;
+  const customData = element.customData && typeof element.customData === "object" ? element.customData : {};
+  return {
+    fontSize,
+    customData: Array.isArray(customData.textRuns) ? {
+      ...customData,
+      textRuns: customData.textRuns.map((run) => typeof run.fontSize === "number" ? {
+        ...run,
+        fontSize: stable(run.fontSize * stableScale)
+      } : run)
+    } : customData
+  };
+};
