# API server origin (protocol + host + port, no path)
# Used by Vite dev server proxy and Tauri/Electron builds
# Example: https://api.example.com (not https://api.example.com/api/v1/)
VITE_API_URL=https://api.example.com

# OCTO server origin used by the Agent Mail development proxy.
# /mail-api/* is rewritten to /v1/mail-gateway/*; browser OCTO token and Space
# headers are preserved. Do not configure an octo-mail owner credential here.
VITE_MAIL_API_URL=http://127.0.0.1:8080

# Direct octo-mail origin used only by the Agent CLI credential path in local
# development. It is not bundled as a credential and carries no static token.
VITE_AGENT_MAIL_API_URL=http://127.0.0.1:8090

# Container runtime values used by docker-entrypoint.sh + Nginx. These are not
# bundled into browser JavaScript. Production should use internal service URLs.
MAIL_API_URL=http://octo-server:8080
AGENT_MAIL_API_URL=http://octo-mail:8080
# Keep aligned with OCTO_MAIL_MAX_SIZE. Nginx accepts bytes or k/m/g suffixes.
MAIL_CLIENT_MAX_BODY_SIZE=50m
# Docker default. Set this to the cluster DNS resolver outside Docker.
NGINX_RESOLVER=127.0.0.11
# HTML source view + version diff entry. Defaults on; set to "false" to hide it.
# The entrypoint writes it into runtime-config.js, so a change needs a container
# restart plus a hard reload (the file is not cache-busted).
OCTO_HTML_SOURCE_DIFF_ENABLED=true

# Marketplace (octo-marketplace) service URL for local dev.
# The Vite proxy rewrites /market/api/v1/* → target/api/v1/*
# For local development with octo-marketplace running on :8092:
# VITE_MARKET_API_URL=http://127.0.0.1:8092

# Loop V3 browser path and local service origin. The browser path is proxied to
# the standalone octo-loop service so it does not collide with OCTO's /v1 API.
# VITE_LOOP_V3_API_BASE=/loop-v3-api/v1
# VITE_LOOP_V3_API_ORIGIN=http://127.0.0.1:8080
# Local octo-server exposes /v1 directly, while deployed gateways retain /api/v1.
# VITE_API_PROXY_STRIP_PREFIX=true
# VITE_LOOP_MODULE_ROOT=../../octo-loop-module
# VITE_LOOP_V3_MODULE_ROOT=../../octo-loop-v3-module

# Enterprise module entry points. Leave empty for the open-source no-op build.
# Multiple entries use the platform path delimiter (: on macOS/Linux, ; on Windows).
# Each configured entry must export:
#   registerEnterpriseModules(context)
#   getEnterpriseStandaloneHandlers()
# Example:
# VITE_ENTERPRISE_MODULES_ENTRY=../../octo-enterprise-modules/src/index.ts
VITE_ENTERPRISE_MODULES_ENTRY=

# Optional enterprise HTML fragment injected into <head> at build time.
# The path is resolved from apps/web when it is relative.
# Example:
# VITE_ENTERPRISE_HTML_HEAD_PATH=../../octo-enterprise-modules/html/head.html
VITE_ENTERPRISE_HTML_HEAD_PATH=

# Dev-server-only filesystem allow-list extension for enterprise source outside this repo.
# It affects Vite dev server /@fs access only; it has no effect on production builds.
# Keep this narrow because apps/web dev server listens on the LAN by default.
# Multiple paths use the platform path delimiter (: on macOS/Linux, ; on Windows).
# Example:
# VITE_ENTERPRISE_FS_ALLOW=../../octo-enterprise-modules:../../octo-loop-module
VITE_ENTERPRISE_FS_ALLOW=
# Drive (octo-drive) service URL for local dev.
# The Vite proxy forwards /v1/drive/* verbatim (drive serves that path natively).
# Falls back to VITE_API_URL when unset. For local development with octo-drive
# running on :8080:
# VITE_DRIVE_API_URL=http://127.0.0.1:8080

# Electron: comma-separated HTTPS origin allowlist for the packaged desktop
# OIDC logout window. This is a BUILD-TIME input: the value is captured into
# apps/web/build/electron-config.json by vite.config.ts and read by the main
# process at startup. Changing it at runtime has no effect on a shipped build.
#
# The allowlist must contain EVERY origin the hidden logout window may load,
# not just the IdP host that receives the initial POST-Logout request:
#
#   1. IdP end-session origins — every host whose /logout, /end_session,
#      /signout (etc.) path the desktop app may contact.
#      e.g. https://sso.company.com, https://login.microsoftonline.com
#
#   2. post_logout_redirect_uri origin(s) — the origin(s) the IdP redirects
#      back to after clearing its session. This is what the main process
#      considers "logout completed" and is usually the web app origin, which
#      can differ from both VITE_API_URL and the IdP host.
#      e.g. https://app.company.com  (when it differs from VITE_API_URL)
#
#      Relative post_logout_redirect_uri values (e.g. "/login") are also
#      accepted — they are resolved against the end-session URL's own origin,
#      which is already an entry in this allowlist by rule (1).
#
#   3. Intermediate HTTP-3xx redirect hops — the logout window now blocks
#      untrusted top-level redirects (will-redirect), so every host in a
#      multi-domain IdP chain must be listed. Microsoft-hosted flows for
#      example traverse login.microsoftonline.com → login.live.com before
#      landing on the redirect target.
#
# The API origin (VITE_API_URL) is ALWAYS added automatically; you do not
# need to list it here. If the OIDC provider is same-origin with the API,
# leave this empty.
#
# A missing entry causes OIDC end-session to fall back to local-only logout
# (IdP session is never terminated; the user can re-SSO without credentials).
# Failures now log a categorized reason to the main-process console — grep
# for "[oidc] IPC_OIDC_OPEN_EXTERNAL rejected" to see which check tripped.
#
# Example (external IdP, split app/API origin, multi-hop federated flow):
# VITE_OIDC_TRUSTED_ORIGINS=https://sso.company.com,https://login.microsoftonline.com,https://login.live.com,https://app.company.com
VITE_OIDC_TRUSTED_ORIGINS=
