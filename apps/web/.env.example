# API server origin (protocol + host + port, no path)
# Used by Vite dev server proxy and Tauri/Electron builds
# Example: https://api.example.com (not https://api.example.com/api/v1/)
VITE_API_URL=https://api.example.com

# Marketplace (octo-marketplace) service URL for local dev.
# The Vite proxy rewrites /market/api/v1/* → target/api/v1/*
# For local development with octo-marketplace running on :8092:
# VITE_MARKET_API_URL=http://127.0.0.1:8092

# Enterprise module entry points. Leave empty for the open-source no-op build.
# Multiple entries use the platform path delimiter (: on macOS/Linux, ; on Windows).
# Each configured entry must export:
#   registerEnterpriseModules(context)
#   getEnterpriseStandaloneHandlers()
# Example:
# VITE_ENTERPRISE_MODULES_ENTRY=../../octo-enterprise-modules/src/index.ts
VITE_ENTERPRISE_MODULES_ENTRY=

# Optional enterprise HTML fragment injected into <head> at build time.
# The path is resolved from apps/web when it is relative.
# Example:
# VITE_ENTERPRISE_HTML_HEAD_PATH=../../octo-enterprise-modules/html/head.html
VITE_ENTERPRISE_HTML_HEAD_PATH=

# Dev-server-only filesystem allow-list extension for enterprise source outside this repo.
# It affects Vite dev server /@fs access only; it has no effect on production builds.
# Keep this narrow because apps/web dev server listens on the LAN by default.
# Multiple paths use the platform path delimiter (: on macOS/Linux, ; on Windows).
# Example:
# VITE_ENTERPRISE_FS_ALLOW=../../octo-enterprise-modules:../../octo-loop-module
VITE_ENTERPRISE_FS_ALLOW=
