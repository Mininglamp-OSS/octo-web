{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "paths": {
      "@octo/base": ["./types/octo-base.shim.d.ts"],
      "@octo/base/src/Service/APIClient": [
        "./types/octo-base-api-client.shim.d.ts"
      ]
    }
  },
  "include": ["src", "types"],
  "exclude": ["dist", "build", "node_modules", "src/**/*.stories.tsx"]
}
