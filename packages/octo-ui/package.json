{
  "name": "@octo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "select": [
        "./dist/select.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "predev": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@douyinfe/semi-icons": "^2.93.0",
    "@douyinfe/semi-ui": "^2.93.0",
    "react": ">=17 <19",
    "react-dom": ">=17 <19"
  },
  "devDependencies": {
    "@douyinfe/semi-icons": "^2.93.0",
    "@douyinfe/semi-ui": "^2.93.0",
    "@storybook/react-vite": "^10.3.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "postcss": "^8",
    "postcss-import": "^16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8",
    "vitest": "^4.1.5"
  }
}
